<module>
	<rawname>callerid</rawname>
	<name>CallerID Managment</name>
	<description>COMMERCIAL MODULE REQUIRES A LICENSE FOR IT TO FUNCTION.The CallerID Management module is a unique way to
	modify the caller ID that is outpulsed on the fly. By dialing a simple feature code you can change the Caller ID for the next call on your extension. Optionally you
	can also specify the Persistent field, If this is checked the CID is permanently changed for all future calls for your extension until another feature code is
	entered to change it </description>
	<publisher>Sangoma Technologies Corporation</publisher>
	<more-info>https://wiki.freepbx.org/display/FPG/Caller+ID+Management</more-info>
	<repo>commercial</repo>
	<license>Commercial</license>
	<licenselink>https://portal.sangoma.com/marketing/resources/2808/Sangoma%20Corporate/Terms%20of%20Service%20and%20User%20License%20Agreement/FreePBXCommercialModule-EndUserAgreement.txt</licenselink>
	<version>17.0.1</version>
	<category>Applications</category>
	<commercial>
		<type>paid</type>
		<link>//www.freepbx.org/add-ons/#callerid-management</link>
	</commercial>
	<changelog>
		*17.0.1alpha* 17.0.1 alpha release
	</changelog>
	<database>
		<table name="callerid_entries">
			<field name="id" type="integer" primarykey="true" autoincrement="true"/>
			<field name="name" type="string" length="50" notnull="false"/>
			<field name="prefix" type="string" length="50" notnull="false"/>
			<field name="cidname" type="string" length="50" notnull="false"/>
			<field name="cidnum" type="string" length="50" notnull="false"/>
			<field name="perm" type="string" length="25" notnull="false"/>
		</table>
	</database>
	<depends>
		<phpcomponent>ionCube PHP Loader</phpcomponent>
		<phpversion>7.4</phpversion>
		<module>sysadmin ge 13.0.69</module>
		<version>13.0.194.5</version>
	</depends>
	<menuitems>
		<callerid>CallerID Management</callerid>
	</menuitems>
	<hooks>
		<framework class="Chown" namespace="FreePBX\Console\Command">
				<method callingMethod="fwcChownFiles" class="Callerid" namespace="FreePBX\modules">chownFreepbx</method>
		</framework>
		<sysadmin class="Sysadmin" namespace="FreePBX\modules">
			<method class="Callerid" namespace="FreePBX\modules" callingMethod="getModuleLicenseInformation">sendModuleLicenseInformation</method>
		</sysadmin>
	</hooks>
	<supported>
		<version>17.0</version>
	</supported>
</module>