<module>
	<rawname>faxpro</rawname>
	<name>Fax Configuration Professional</name>
	<version>17.0.1.22</version>
	<publisher>Sangoma Technologies Corporation</publisher>
	<license>Commercial</license>
	<licenselink>https://portal.sangoma.com/marketing/resources/2808/Sangoma%20Corporate/Terms%20of%20Service%20and%20User%20License%20Agreement/FreePBXCommercialModule-EndUserAgreement.txt</licenselink>
	<repo>commercial</repo>
	<type>setup</type>
	<category>Settings</category>
	<more-info>https://sangomakb.atlassian.net/wiki/spaces/PG/pages/34177114/Fax+Pro</more-info>
	<description>COMMERCIAL MODULE REQUIRES A LICENSE FOR IT TO FUNCTION. The
		Fax Pro module adds functionality to the standard
		FreePBX Fax modue. Outbound faxing can be done through a web interface on your FreePBX system. Simply type in a phone
		number and upload a PDF. You can optionally set the
		outgoing PDF to use a locally stored fax coversheet with your faxes; and type in a personal message on the coversheet</description>
	<changelog>
		*17.0.1.22* FREEI-1588 FAXPRO module backup from 15 with restore to 17 fails 
		*17.0.1.21* FREEI-1551 outgoing fax fix for FreePbx17 
		*17.0.1.20* FREEI-1529 inbound fax email notification issue fix 
		*17.0.1.18* bump 
		*17.0.1* 17.0.1 alpha release
	</changelog>
	<commercial>
		<type>paid</type>
		<link>//www.freepbx.org/add-ons/#fax-pro</link>
	</commercial>
	<depends>
		<version>17.0.1</version>
		<phpcomponent>ionCube PHP Loader</phpcomponent>
		<phpversion>8.2</phpversion>
		<module>userman ge 17.0.1</module>
		<module>sysadmin ge 17.0.1</module>
		<module>fax ge 17.0.1</module>
	</depends>
	<supported>
		<version>17.0</version>
	</supported>
	<methods>
		<get_config pri="250">faxpro250_get_config</get_config>
		<get_config pri="600">faxpro600_get_config</get_config>
	</methods>
	<hooks>
		<framework class="Chown" namespace="FreePBX\Console\Command">
			<method callingMethod="fwcChownFiles" class="Faxpro" namespace="FreePBX\modules">chownFreepbx</method>
		</framework>
		<userman class="Userman" namespace="FreePBX\modules">
			<method callingMethod="delGroup" class="Faxpro" namespace="FreePBX\modules">usermanDelGroup</method>
			<method callingMethod="addGroup" class="Faxpro" namespace="FreePBX\modules">usermanAddGroup</method>
			<method callingMethod="updateGroup" class="Faxpro" namespace="FreePBX\modules">usermanUpdateGroup</method>
			<method callingMethod="myShowPage" class="Faxpro" namespace="FreePBX\modules">usermanShowPage</method>
			<method callingMethod="delUser" class="Faxpro" namespace="FreePBX\modules">usermanDelUser</method>
			<method callingMethod="addUser" class="Faxpro" namespace="FreePBX\modules">usermanAddUser</method>
			<method callingMethod="updateUser" class="Faxpro" namespace="FreePBX\modules">usermanUpdateUser</method>
		</userman>
		<bulkhandler class="Bulkhandler" namespace="FreePBX\modules">
			<method callingMethod="export" class="Faxpro" namespace="FreePBX\modules">bulkhandlerExport</method>
			<method callingMethod="import" class="Faxpro" namespace="FreePBX\modules">bulkhandlerImport</method>
		</bulkhandler>
		<backup class="Backup" namespace="FreePBX\modules">
			<method callingMethod="getBackupSettingsDisplay" class="Faxpro" namespace="FreePBX\modules">getBackupSettingsDisplay</method>
			<method callingMethod="processBackupSettings" class="Faxpro" namespace="FreePBX\modules">processBackupSettings</method>
		</backup>
	</hooks>
	<database>
		<table name="fax_store">
			<field name="faxid" type="string" length="25" default="" primarykey="true"/>
			<field name="user" type="string" length="25" notnull="false"/>
			<field name="dir" type="string" length="10" notnull="false"/>
			<field name="date" type="string" length="12" notnull="false"/>
			<field name="header" type="string" length="80" notnull="false"/>
			<field name="stationid" type="string" length="50" notnull="false"/>
			<field name="callid" type="string" length="75" notnull="false"/>
			<field name="dest" type="string" length="20" notnull="false"/>
			<field name="status" type="string" length="255" notnull="false"/>
			<field name="pages" type="string" length="10" notnull="false"/>
			<field name="file" type="string" length="100" notnull="false"/>
			<field name="new" type="string" length="10" notnull="false"/>
			<field name="finished" type="string" length="2" default="1" notnull="false"/>
			<field name="pid" type="integer" notnull="false"/>
			<field name="channel" type="string" length="255" notnull="false"/>
		</table>
		<table name="faxpro_hook_core">
			<field name="page" type="string" length="150" default="" primarykey="true"/>
			<field name="id" type="string" length="150" default="" primarykey="true"/>
			<field name="status" type="string" length="255" default=""/>
		</table>
	</database>
</module>