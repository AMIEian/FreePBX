	<depends>
		<phpcomponent>ionCube PHP Loader</phpcomponent>
		<phpversion>8.2</phpversion>
		<module>sysadmin ge 17.0.1</module>
		<module>recordings</module>
		<module>framework ge 17.0.1</module>
		<module>filestore ge 17.0.1</module>
	</depends>
	<database>
		<table name="recording_report">
			<field name="key" type="string" length="25" notnull="false"/>
			<field name="value" type="text" notnull="false"/>
			<key name="key" type="unique">
				<column name="key"/>
			</key>
		</table>
		<table name="recording_files">
			<field name="file" type="string" length="190" default="" primarykey="true"/>
			<field name="duration" type="integer" notnull="false"/>
			<field name="updated" type="integer" notnull="false"/>
		</table>
	</database>
	<menuitems>
		<recording_report>Call Recordings</recording_report>
	</menuitems>
	<supported>
		<version>17.0</version>
	</supported>
	<console>
		<command>
			<name>recordingreports</name>
			<class>Recording_report</class>
		</command>
	</console>
</module>
