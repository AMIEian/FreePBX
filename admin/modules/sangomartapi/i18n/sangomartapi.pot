msgid ""
"<p>Choose a log level to control the level of detail in all logs within "
"RTAPI Modules, including Feature Logs as well:</p><ul>\n"
"\t\t\t\t\t\t\t\t<li><strong>DEBUG:</strong> Detailed debugging (Value: 10).</"
"li>\n"
"\t\t\t\t\t\t\t\t<li><strong>INFO:</strong> General information (Value: 20).</"
"li>\n"
"\t\t\t\t\t\t\t\t<li><strong>WARN:</strong> Potential issues (Value: 30).</"
"li>\n"
"\t\t\t\t\t\t\t\t<li><strong>ERROR:</strong> Critical errors (Value: 40).</"
"li></ul>\n"
"\t\t\t\t\t\t\t<p>Selecting a level also includes all higher levels. For "
"example, choosing 'INFO' also includes 'WARN' and 'ERROR' logs.</p>"
msgstr ""

